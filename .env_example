# =============================================================================
# Camagru - Variables de entorno
# Generado automáticamente por env_setup.sh
# Usuario del sistema: sale de $whoami
# =============================================================================

# Configuración de Base de Datos
DB_HOST=db
DB_PORT=3306
DB_NAME=camagru
DB_USER=tu_usuario_de_base_de_datos
DB_PASS=tu_contraseña_de_base_de_datos
DB_ROOT_PASS=tu_contraseña_de_root_de_base_de_datos

# URL de la Aplicación
APP_URL=http://localhost:8080

# Configuración de Correo (usa un servicio como Mailtrap para pruebas)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=tu_usuario_de_mailtrap
MAIL_PASS=tu_contraseña_de_mailtrap
MAIL_FROM=noreply@camagru.local

# Seguridad
SESSION_SECRET=tu_clave_secreta_para_sesiones 
# te puedes generar una usando un generador de claves aleatorias 
# de 32 caracteres en línea de comandos, por ejemplo: `openssl rand -base64 32`
